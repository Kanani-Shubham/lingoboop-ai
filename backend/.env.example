# ==============================================================================
# LingoBoom Backend Environment Configuration (.env.example)
#
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO VERSION CONTROL.
# Copy this file to backend/.env and provide your actual credentials.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME=LingoBoom-Backend
DEBUG=false
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# Gnani AI Suite Configuration (api.vachana.ai)
# Verified Authentication: Passed via 'X-API-Key-ID' header
# ------------------------------------------------------------------------------
GNANI_BASE_URL=https://api.vachana.ai
GNANI_WS_URL=wss://api.vachana.ai
GNANI_API_KEY=your_gnani_dashboard_api_key_here

# STT Configuration (Prisma)
GNANI_STT_PATH=/stt/v3
GNANI_STT_STREAM_PATH=/stt/v3/stream
GNANI_STT_DEFAULT_MODEL=prisma-v3.0

# TTS Configuration (Timbre)
GNANI_TTS_PATH=/api/v1/tts/inference
GNANI_TTS_SSE_PATH=/api/v1/tts/sse
GNANI_TTS_WS_PATH=/api/v1/tts
GNANI_TTS_DEFAULT_MODEL=timbre-v3.0
GNANI_TTS_DEFAULT_VOICE=Shivani

# ------------------------------------------------------------------------------
# Supabase Configuration
# Service role key is strictly backend-only. Never expose to client.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_backend_key_here
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres

# Rate Limiting & Timeouts
GNANI_REQUEST_TIMEOUT_SECONDS=30.0
RATE_LIMIT_REQUESTS_PER_MINUTE=60
