# ==============================================================================
# LingoBoom Environment Configuration (.env.example)
#
# DO NOT COMMIT PRODUCTION SECRETS OR REAL CREDENTIALS TO VERSION CONTROL.
# Copy this file to .env or backend/.env for local development.
# Production secrets must be managed via backend environment variables / secret managers.
# ==============================================================================

# Application Environment: development | staging | production
APP_ENV=development
APP_NAME=LingoBoom
APP_VERSION=1.0.0+1

# ------------------------------------------------------------------------------
# Backend Service (FastAPI) Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_BASE_URL=http://10.0.2.2:8000
BACKEND_WS_URL=ws://10.0.2.2:8000/ws
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_for_jwt

# ------------------------------------------------------------------------------
# Gnani AI Suite Credentials (BACKEND ONLY - NEVER COMMIT IN MOBILE CLIENT)
# Official host: api.vachana.ai | Header: X-API-Key-ID
# ------------------------------------------------------------------------------
GNANI_BASE_URL=https://api.vachana.ai
GNANI_WS_URL=wss://api.vachana.ai
GNANI_API_KEY=your_gnani_dashboard_api_key_here

GNANI_STT_PATH=/stt/v3
GNANI_STT_STREAM_PATH=/stt/v3/stream
GNANI_STT_DEFAULT_MODEL=prisma-v3.0

GNANI_TTS_PATH=/api/v1/tts/inference
GNANI_TTS_SSE_PATH=/api/v1/tts/sse
GNANI_TTS_WS_PATH=/api/v1/tts
GNANI_TTS_DEFAULT_MODEL=timbre-v3.0
GNANI_TTS_DEFAULT_VOICE=Nalini

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Payment Gateway Configuration (India / INR Subscriptions)
# Monthly: ₹9 | Yearly: ₹49
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_backend_only
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# Monitoring, Logging & Crash Reporting
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your_sentry_dsn_public@o0.ingest.sentry.io/0
POSTHOG_API_KEY=phc_your_posthog_project_api_key
POSTHOG_HOST=https://app.posthog.com
